datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model Admin {
  id         String       @id @default(uuid())
  nome       String
  email      String       @unique
  senha      String       
  criadoEm   DateTime     @default(now())
  
  observacoes Observacao[] 
}

model Evento {
  id           String      @id @default(uuid())
  nome         String       
  tipo         String      // CENACULO, KIDS, CENACULAO, FESTIVIDADE, OUTRO
  status       String      @default("AUTOMATICO") // Pode ser ABERTO, FECHADO, CONCLUIDO ou AUTOMATICO
  dataInicio   DateTime
  criadoEm     DateTime    @default(now())
  
  // 🔴 NOVOS CAMPOS PARA AUTOMAÇÃO E VISUAL
  imagemCapa   String?     // URL da imagem no Cloudinary
  dataAbertura DateTime?   // Quando o sistema deve abrir as vagas sozinho
  duracaoDias  Int         @default(1) // 1, 2 ou 3 dias

  inscricoes   Inscricao[]  
  fotos        Foto[]       
}

model Foto {
  id        String   @id @default(uuid())
  url       String   // URL da imagem
  criadoEm  DateTime @default(now())

  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model Inscricao {
  id                  String       @id @default(uuid())
  nomeCompleto        String
  instagram           String?
  email               String
  cidade              String
  telefone            String
  jaFezCenaculo       String?
  dataNascimento      DateTime
  problemaSaude       String?
  paroquiaAtuante     String?
  medicacaoControlada String?
  restricaoAlimentar  String?
  atendimentoEspecial String?
  comoConheceu        String?
  criadoEm            DateTime     @default(now())

  eventoId            String
  evento              Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  
  observacoes         Observacao[] 
}

model Observacao {
  id          String    @id @default(uuid())
  texto       String
  criadoEm    DateTime  @default(now())

  adminId     String
  admin       Admin     @relation(fields: [adminId], references: [id])

  inscricaoId String
  inscricao   Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
}

// NOVA TABELA: Lista de Espera / Pré-cadastro
model PreCadastro {
  id        String   @id @default(uuid())
  nome      String
  email     String
  telefone  String
  tipo      String   @default("CENACULO") // CENACULO, KIDS ou CENACULAO
  criadoEm  DateTime @default(now())
}

// 1. O "Elenco" da comunidade
model Membro {
  id             String     @id @default(uuid())
  nome           String
  grupo          String     // Ex: "Grupo São José"
  cenaculoFeito  String?    // Ex: "83º Cenáculo"
  criadoEm       DateTime   @default(now())
  
  presencas      Presenca[] // Ligação mágica do Prisma
}

// 2. Os eventos menores (Missas, Reuniões, etc)
model Atividade {
  id          String     @id @default(uuid())
  nome        String     
  data        DateTime
  criadoEm    DateTime   @default(now())
  
  presencas   Presenca[] // Ligação mágica do Prisma
}

// 3. O registro de quem foi em qual atividade (A "Chamada")
model Presenca {
  id          String    @id @default(uuid())
  criadoEm    DateTime  @default(now())

  membroId    String
  membro      Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)
  
  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  // Essa regra bloqueia que um coordenador dê presença duas vezes pra mesma pessoa no mesmo evento!
  @@unique([membroId, atividadeId]) 
}

model Usuario {
  id             String   @id @default(uuid())
  nome           String   @unique
  senha          String
  primeiroAcesso Boolean  @default(true) // 🔴 NOVO: Todo usuário nasce precisando trocar a senha
  criadoEm       DateTime @default(now())
}