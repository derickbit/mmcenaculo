datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model Evento {
  id           String      @id @default(uuid())
  nome         String       
  tipo         String      // CENACULO, KIDS, CENACULAO, FESTIVIDADE, OUTRO
  status       String      @default("AUTOMATICO") // Pode ser ABERTO, FECHADO, CONCLUIDO ou AUTOMATICO
  dataInicio   DateTime
  criadoEm     DateTime    @default(now())
  
  // 🔴 NOVOS CAMPOS PARA AUTOMAÇÃO E VISUAL
  imagemCapa   String?     // URL da imagem no Cloudinary
  dataAbertura DateTime?   // Quando o sistema deve abrir as vagas sozinho
  duracaoDias  Int         @default(1) // 1, 2 ou 3 dias

  inscricoes   Inscricao[]  
  inscricoesKids InscricaoKids[]
  fotos        Foto[]       
}

model Foto {
  id        String   @id @default(uuid())
  url       String   // URL da imagem
  criadoEm  DateTime @default(now())

  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model Inscricao {
  id                  String       @id @default(uuid())
  nomeCompleto        String
  instagram           String?
  email               String
  cidade              String
  telefone            String
  jaFezCenaculo       String?
  dataNascimento      DateTime
  problemaSaude       String?
  paroquiaAtuante     String?
  medicacaoControlada String?
  restricaoAlimentar  String?
  atendimentoEspecial String?
  comoConheceu        String?
  criadoEm            DateTime     @default(now())
  consentimentoEm     DateTime?    // quando a pessoa aceitou o termo (LGPD); nulo = inscrição anterior à caixinha de consentimento

  eventoId            String
  evento              Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  
  observacoes         Observacao[] 

  @@unique([email, eventoId])
}

// Inscrição do Cenáculo Kids. Fica separada da inscrição de adultos de propósito:
// só guarda dados simples da criança; o consentimento é dado pelo responsável (LGPD).
model InscricaoKids {
  id                  String   @id @default(uuid())
  criadoEm            DateTime @default(now())

  // Criança: apenas dados simples (sem sobrenome, e-mail, telefone ou endereço)
  criancaNome         String   // primeiro nome
  criancaNascimento   DateTime
  saudeObservacao     String?  // texto opcional (alergia, restrição, medicação)
  saudeComEquipe      Boolean  @default(false) // true = prefere falar direto com a equipe no dia (e não registra aqui)

  // Responsável: contato e quem dá o consentimento
  responsavelNome     String
  responsavelTelefone String
  responsavelEmail    String   // normalizado em minúsculas pela API
  parentesco          String

  consentimentoEm     DateTime // quando o responsável aceitou o termo

  eventoId            String
  evento              Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  observacoes         Observacao[]

  // Irmãos podem se inscrever (nome ou nascimento mudam); a mesma criança, não.
  @@unique([eventoId, responsavelEmail, criancaNome, criancaNascimento])
}

model Observacao {
  id          String    @id @default(uuid())
  texto       String
  criadoEm    DateTime  @default(now())

  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])

  // Uma nota pertence a uma inscrição de adulto OU a uma inscrição Kids (nunca às duas; o código garante).
  inscricaoId     String?
  inscricao       Inscricao?     @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  inscricaoKidsId String?
  inscricaoKids   InscricaoKids? @relation(fields: [inscricaoKidsId], references: [id], onDelete: Cascade)
}

// NOVA TABELA: Lista de Espera / Pré-cadastro
model PreCadastro {
  id        String   @id @default(uuid())
  nome      String
  email     String
  telefone  String
  tipo      String   @default("CENACULO") // CENACULO, KIDS ou CENACULAO
  criadoEm  DateTime @default(now())
}

// 1. O "Elenco" da comunidade
model Membro {
  id             String     @id @default(uuid())
  nome           String
  grupo          String     // Ex: "Grupo São José"
  cenaculoFeito  String?    // Ex: "83º Cenáculo"
  criadoEm       DateTime   @default(now())
  
  presencas      Presenca[] // Ligação mágica do Prisma
}

// 2. Os eventos menores (Missas, Reuniões, etc)
model Atividade {
  id          String     @id @default(uuid())
  nome        String     
  data        DateTime
  criadoEm    DateTime   @default(now())
  
  presencas   Presenca[] // Ligação mágica do Prisma
}

// 3. O registro de quem foi em qual atividade (A "Chamada")
model Presenca {
  id          String    @id @default(uuid())
  criadoEm    DateTime  @default(now())

  membroId    String
  membro      Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)
  
  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  // Essa regra bloqueia que um coordenador dê presença duas vezes pra mesma pessoa no mesmo evento!
  @@unique([membroId, atividadeId]) 
}

model Usuario {
  id             String   @id @default(uuid())
  nome           String   @unique
  senha          String
  papel          String   @default("COORDENACAO") // ADMIN (gere contas) ou COORDENACAO; os dois veem todos os dados
  ativo          Boolean  @default(true) // conta desativada não entra
  // Sessões (cookies de login) emitidas antes desta data deixam de valer. Uma redefinição de senha avança esta data.
  sessoesValidasDesde DateTime @default(now())
  criadoEm       DateTime @default(now())

  observacoes    Observacao[]
  convitesCriados Convite[] @relation("ConviteCriador")
  convite         Convite?  @relation("ConviteUsuario") // o convite que criou esta conta (se houve)
  convitesDeRedefinicao Convite[] @relation("ConviteAlvo") // links de redefinição de senha desta conta
}

// Contador de tentativas por chave (ex.: "inscricao:203.0.113.5") dentro de uma janela de tempo.
// Serve para limitar abuso (inscrição, pré-cadastro, login). Ver lib/limite.ts.
model LimiteTentativa {
  chave        String   @id
  janelaInicio DateTime
  contagem     Int
}

// Convite para criar uma conta do painel: link de uso único, com validade. O admin escolhe o usuário; quem aceita só
// define a senha. Só o hash do código fica no banco (o código em si aparece uma única vez, para o admin copiar).
// Um convite sempre cria uma conta COORDENACAO; ADMIN só nasce pelo script do primeiro admin.
model Convite {
  id          String    @id @default(uuid())
  codigoHash  String    @unique // sha256 do código
  nomeUsuario String    // usuário reservado pelo admin
  criadoEm    DateTime  @default(now())
  expiraEm    DateTime
  usadoEm     DateTime?
  revogadoEm  DateTime?

  criadoPorId String
  criadoPor   Usuario   @relation("ConviteCriador", fields: [criadoPorId], references: [id])

  usadoPorId  String?   @unique
  usadoPor    Usuario?  @relation("ConviteUsuario", fields: [usadoPorId], references: [id])

  // Preenchido só nos links de REDEFINIÇÃO de senha: a conta que já existe e vai ganhar uma senha nova.
  // Vazio = convite para criar uma conta nova.
  usuarioAlvoId String?
  alvo          Usuario?  @relation("ConviteAlvo", fields: [usuarioAlvoId], references: [id])
}
