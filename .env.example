# Banco PostgreSQL (local com docker-compose ou Supabase)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/cenaculodb"

# Segredo usado para assinar a sessão do painel admin.
# Gere um valor aleatório com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Nome da conta no Cloudinary (envio de imagens; preset: cenaculo_preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Banco só para testes automáticos (o nome precisa terminar em _test). Opcional: sem ele, os testes de banco são pulados.
DATABASE_URL_TESTE=""
